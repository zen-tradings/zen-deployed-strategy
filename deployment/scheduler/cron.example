# Cron alternative to the systemd timers. Prefer systemd (alerting, hardening, catch-up).
# Install in the `zen` user's crontab (crontab -u zen -e), NOT root's.
# Cron has no per-job timezone — set the host clock: timedatectl set-timezone America/New_York
# Env vars must be sourced since cron has no EnvironmentFile; `set -a` exports them.
SHELL=/bin/bash
APP=/opt/zen-deployed-strategy
# Data role — after-close pull:
10 17 * * 1-5  cd $APP && set -a && . /etc/zen-strategy/data.env && .venv/bin/python -m data.pull --lookback-days 400 >> /var/log/zen-strategy/pull.log 2>&1
# Strategy role — runs after the pull has landed:
40 17 * * 1-5  cd $APP && set -a && . /etc/zen-strategy/runner.env && .venv/bin/python -m deployment.runner --frequency daily   >> /var/log/zen-strategy/daily.log 2>&1
45 17 * * 5    cd $APP && set -a && . /etc/zen-strategy/runner.env && .venv/bin/python -m deployment.runner --frequency weekly  >> /var/log/zen-strategy/weekly.log 2>&1
# monthly: days 1-3 so a weekend month-start still runs; runner emits once per month
50 17 1-3 * *  cd $APP && set -a && . /etc/zen-strategy/runner.env && .venv/bin/python -m deployment.runner --frequency monthly >> /var/log/zen-strategy/monthly.log 2>&1
# health check (exit 1 => inspect logs)
15 18 * * 1-5  cd $APP && set -a && . /etc/zen-strategy/runner.env && .venv/bin/python -m deployment.ops.health >> /var/log/zen-strategy/health.log 2>&1
