# Template for server-side env files. Copy to the server, fill in, chmod 600.
# NEVER commit real values. Suggested locations:
#   data server:     /etc/zen-strategy/data.env
#   strategy server: /etc/zen-strategy/runner.env + /etc/zen-strategy/alpaca.env

# --- data server ---
MASSIVE_API_KEY=
STRATEGY_DATA_DIR=/var/lib/strategy-data

# --- strategy server ---
STRATEGY_SIGNALS_DIR=/var/lib/strategy-signals

# --- alpaca accounts (one pair per account alias in config/accounts.yaml) ---
ALPACA_PAPER_1_KEY=
ALPACA_PAPER_1_SECRET=
ALPACA_PAPER_2_KEY=
ALPACA_PAPER_2_SECRET=
ALPACA_PAPER_3_KEY=
ALPACA_PAPER_3_SECRET=
# ...add up to ALPACA_PAPER_9 as accounts come online
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
