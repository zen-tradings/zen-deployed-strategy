# Template for server-side env files. Copy to the server, fill in, chmod 600,
# chown zen:zen. NEVER commit real values. Files (all under /etc/zen-strategy/):
#   data.env    -> data-pull.service
#   runner.env  -> strategy-run@.service, zen-health.service
#   alpaca.env  -> manual `deployment.execution` runs only
#   alerts.env  -> zen-notify@.service (optional)
# Single host: data and strategy roles share STRATEGY_DATA_DIR (no rsync).

# --- data.env ---
MASSIVE_API_KEY=
STRATEGY_DATA_DIR=/var/lib/strategy-data

# --- runner.env ---
STRATEGY_DATA_DIR=/var/lib/strategy-data
STRATEGY_SIGNALS_DIR=/var/lib/strategy-signals

# --- alpaca.env (one pair per account alias in config/accounts.yaml) ---
ALPACA_PAPER_1_KEY=
ALPACA_PAPER_1_SECRET=
ALPACA_PAPER_2_KEY=
ALPACA_PAPER_2_SECRET=
ALPACA_PAPER_3_KEY=
ALPACA_PAPER_3_SECRET=
# ...add up to ALPACA_PAPER_9 as accounts come online
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# iex works on free plans; use sip only with a paid market-data subscription
ALPACA_DATA_FEED=iex

# --- alerts.env (optional) ---
ALERT_WEBHOOK_URL=
